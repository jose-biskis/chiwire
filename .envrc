source_env_if_exists .env.deploy.local
watch_file .env.deploy.local

if [[ -n "${DEPLOY_SSH_TARGET:-}" ]]; then
  export SSH_HOST="$DEPLOY_SSH_TARGET"
elif [[ -n "${DEPLOY_SSH_USER:-}" && -n "${DEPLOY_SSH_HOST:-}" ]]; then
  export SSH_HOST="${DEPLOY_SSH_USER}@${DEPLOY_SSH_HOST}"
fi

if [[ -n "${DEPLOY_SSH_PORT:-}" ]]; then
  export SSH_PORT="$DEPLOY_SSH_PORT"
fi

if [[ -n "${DEPLOY_SSH_IDENTITY_FILE:-}" ]]; then
  export SSH_IDENTITY_FILE="$DEPLOY_SSH_IDENTITY_FILE"
fi

if [[ -n "${DEPLOY_SSH_PASSWORD:-}" ]]; then
  export SSHPASS="$DEPLOY_SSH_PASSWORD"
fi

# App secrets from .env.deploy.local (needed by deploy runtime.envFrom).
# direnv's source_env loads KEY=value as shell vars; export so npm/deploy see them.
if [[ -n "${GF_SECURITY_ADMIN_PASSWORD:-}" ]]; then
  export GF_SECURITY_ADMIN_PASSWORD
fi
# One DB secret: PGPASSWORD also fills POSTGRES_PASSWORD for apps/postgres deploy.
if [[ -n "${PGPASSWORD:-}" ]]; then
  export PGPASSWORD
  export POSTGRES_PASSWORD="$PGPASSWORD"
fi
if [[ -n "${REDIS_PASSWORD:-}" ]]; then
  export REDIS_PASSWORD
fi
if [[ -n "${RADIOBEMBA_AUTH_TOKEN:-}" ]]; then
  export RADIOBEMBA_AUTH_TOKEN
fi
if [[ -n "${GARITA_ADMIN_SECRET:-}" ]]; then
  export GARITA_ADMIN_SECRET
fi

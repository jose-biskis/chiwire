{
  "name": "@chiwire/db-migrate",
  "version": "0.1.0",
  "private": true,
  "description": "Declarative Postgres schema apply with checksum history.",
  "type": "module",
  "bin": {
    "chiwire-db-migrate": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build --pretty false",
    "db-migrate": "node dist/cli.js",
    "test": "npm run build && node --test dist/**/*.test.js"
  },
  "dependencies": {
    "@chiwire/core": "0.1.0"
  }
}

{
  "name": "@chiwire/valenstonic-academy-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Valenstonic Academy API — recipes, assets, courses, interactive practices.",
  "type": "module",
  "scripts": {
    "build": "tsc --build",
    "start": "node dist/index.js",
    "typecheck": "tsc --build --pretty false",
    "db:status": "chiwire-db-migrate status --schema vt_academy --dir schemas",
    "db:plan": "chiwire-db-migrate plan --schema vt_academy --dir schemas",
    "db:apply": "chiwire-db-migrate apply --schema vt_academy --dir schemas",
    "db:validate": "chiwire-db-migrate validate --schema vt_academy --dir schemas"
  },
  "dependencies": {
    "@chiwire/core": "*",
    "@chiwire/db-migrate": "*",
    "@chiwire/valenstonic-academy-shared": "*",
    "knex": "^3.1.0"
  }
}

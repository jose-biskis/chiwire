{
  "image": "chiwire/contimiti",
  "tag": "latest",
  "container": "contimiti",
  "build": {
    "context": "../..",
    "dockerfile": "Dockerfile"
  },
  "runtime": {
    "containerPort": 3000,
    "visibility": "domain",
    "hostPort": 8020,
    "volumes": [
      "chiwire-contimiti-data:/data"
    ],
    "env": {
      "REDIS_HOST": "redis-cache",
      "REDIS_PORT": "6379"
    },
    "envFrom": [
      "REDIS_PASSWORD"
    ],
    "network": "chiwire"
  },
  "proxy": {
    "type": "caddy",
    "domain": "contimiti.avilalabs.dev"
  }
}

{
  "name": "@chiwire/design-system",
  "version": "0.1.0",
  "private": true,
  "description": "Chiwire design-system Storybook — archetypes for Internal, Valenstonic, and future brands.",
  "type": "module",
  "scripts": {
    "dev": "storybook dev -p 6006 --no-open",
    "build": "npm run build:storybook && npm run build:server",
    "build:storybook": "storybook build -o storybook-static",
    "build:server": "tsc --build",
    "start": "node dist/server.js",
    "typecheck": "tsc --build --pretty false && tsc -p tsconfig.ui.json --pretty false --noEmit"
  },
  "dependencies": {
    "@chiwire/ui": "*",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.525.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^9.1.20",
    "@storybook/react-vite": "^9.1.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "storybook": "^9.1.20",
    "tailwindcss": "^4.3.3",
    "vite": "^7.3.6"
  }
}

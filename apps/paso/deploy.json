{
  "image": "chiwire/paso",
  "tag": "latest",
  "container": "paso",
  "build": {
    "context": ".",
    "dockerfile": "Dockerfile"
  },
  "runtime": {
    "containerPort": 500,
    "visibility": "public",
    "hostPort": 500,
    "bindAddress": "auto",
    "bindAddressFrom": "PASO_BIND_ADDRESS",
    "advertiseAddressEnv": "VPN_PUBLIC_IP",
    "publishUdp": true,
    "setPortEnv": false,
    "extraPorts": [
      "4500:4500/udp"
    ],
    "volumes": [
      "chiwire-paso-data:/var/lib/paso"
    ],
    "runArgs": [
      "--cap-add",
      "NET_ADMIN",
      "--sysctl",
      "net.ipv4.ip_forward=1",
      "--sysctl",
      "net.ipv4.conf.all.src_valid_mark=1"
    ],
    "env": {
      "VPN_CLIENT_NET": "10.10.10.0/24",
      "VPN_DNS": "1.1.1.1,1.0.0.1"
    },
    "envFrom": [
      "VPN_USERNAME",
      "VPN_PASSWORD"
    ],
    "network": "chiwire"
  }
}

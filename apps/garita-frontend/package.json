{
  "name": "@chiwire/garita-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Garita UI — internal infra backoffice frontend.",
  "type": "module",
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc --build",
    "build:client": "vite build",
    "dev:client": "vite",
    "start": "node dist/index.js",
    "typecheck": "tsc --build --pretty false && tsc -p tsconfig.client.json --pretty false --noEmit"
  },
  "dependencies": {
    "@chiwire/ui": "*",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.1.11",
    "vite": "^7.0.5"
  }
}

{
  "image": "chiwire/velero-frontend",
  "tag": "latest",
  "container": "velero-frontend",
  "build": {
    "context": "../..",
    "dockerfile": "Dockerfile"
  },
  "runtime": {
    "containerPort": 3000,
    "visibility": "domain",
    "hostPort": 8070,
    "env": {
      "API_BASE_URL": "http://velero-backend:3000"
    },
    "network": "chiwire"
  },
  "proxy": {
    "type": "caddy",
    "domain": "velero.avilalabs.dev"
  }
}

{
  "name": "@chiwire/velero-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Velero desk UI — live CLI tape, start/stop, saved watch profiles.",
  "type": "module",
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc --build",
    "build:client": "vite build",
    "dev:client": "vite",
    "start": "node dist/index.js",
    "typecheck": "tsc --build --pretty false && tsc -p tsconfig.client.json --pretty false --noEmit"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^7.0.5"
  }
}

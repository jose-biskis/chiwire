{
  "image": "chiwire/velero-backend",
  "tag": "latest",
  "container": "velero-backend",
  "build": {
    "context": "../..",
    "dockerfile": "Dockerfile"
  },
  "runtime": {
    "containerPort": 3000,
    "visibility": "domain",
    "hostPort": 8071,
    "volumes": [
      "chiwire-velero-data:/data"
    ],
    "env": {
      "PORT": "3000",
      "VELERO_PROFILES_PATH": "/data/profiles.json",
      "VELERO_REQUIRE_GATE": "true"
    },
    "envFrom": [
      "VELERO_GATE_TOKEN",
      "VELERO_LIVE",
      "VELERO_MAX_NOTIONAL",
      "VELERO_MAX_LEVERAGE",
      "VELERO_MAX_OPEN"
    ],
    "envRequired": [
      "VELERO_GATE_TOKEN"
    ],
    "network": "chiwire"
  },
  "proxy": {
    "type": "caddy",
    "domain": "api.velero.avilalabs.dev"
  }
}

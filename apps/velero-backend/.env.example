PORT=3001
# Profiles JSON. Default is apps/velero-backend/data/profiles.json
# VELERO_PROFILES_PATH=/data/profiles.json

# Keys are loaded from apps/velero/.env (same as the CLI).
# You can also set them here; process env wins over the file.
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# VELERO_LIVE=true
# VELERO_PROXY=http://127.0.0.1:3128

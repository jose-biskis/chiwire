{
  "image": "chiwire/garita-backend",
  "tag": "latest",
  "container": "garita-backend",
  "build": {
    "context": "../..",
    "dockerfile": "Dockerfile"
  },
  "runtime": {
    "containerPort": 3000,
    "visibility": "internal",
    "hostPort": 8061,
    "env": {
      "PGHOST": "postgres-pgbouncer",
      "PGPORT": "6432",
      "PGUSER": "chiwire",
      "PGDATABASE": "chiwire",
      "REDIS_HOST": "redis-cache",
      "REDIS_PORT": "6379"
    },
    "envFrom": [
      "PGPASSWORD",
      "REDIS_PASSWORD",
      "GARITA_ADMIN_SECRET"
    ],
    "network": "chiwire"
  }
}

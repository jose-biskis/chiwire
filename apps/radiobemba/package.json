{
  "name": "@chiwire/radiobemba",
  "version": "0.1.0",
  "private": true,
  "description": "Radiobemba — self-hosted HTTP tunnels over SSH reverse forwards.",
  "type": "module",
  "scripts": {
    "build": "tsc --build",
    "start": "node dist/index.js",
    "typecheck": "tsc --build --pretty false",
    "db:status": "chiwire-db-migrate status --schema radiobemba --dir schemas",
    "db:plan": "chiwire-db-migrate plan --schema radiobemba --dir schemas",
    "db:apply": "chiwire-db-migrate apply --schema radiobemba --dir schemas",
    "db:validate": "chiwire-db-migrate validate --schema radiobemba --dir schemas"
  },
  "dependencies": {
    "@chiwire/core": "*",
    "@chiwire/db-migrate": "*",
    "@chiwire/radiobemba-shared": "*",
    "knex": "^3.1.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/ssh2": "^1.15.5"
  }
}

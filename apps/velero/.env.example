# Futures trading only. Do not enable withdrawals on this key.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Real money requires this AND CLI flags: --live --confirm
VELERO_LIVE=false

# Optional hard caps (USDT notional, leverage, concurrent positions)
# VELERO_MAX_NOTIONAL=25
# VELERO_MAX_LEVERAGE=10
# VELERO_MAX_OPEN=3

# Optional taker fee as a decimal (0.001 = 0.10%). Overrides Binance commissionRate.
# VELERO_TAKER_FEE=0.001

# Binance geo-blocks many IPs. Point this at Reja or another HTTPS proxy.
# VELERO_PROXY=http://127.0.0.1:3128
